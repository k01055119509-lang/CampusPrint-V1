# 独立项目。不要复制参考应用的 .env 或数据库。
HOST=127.0.0.1
PORT=4328
NODE_ENV=development
DATA_DIR=var
# 默认停用学生账号入口和服务端账号操作；受控重启后生效。
# 管理员认证及账号安全不受影响。重新开启不会恢复已撤销会话或合并访客数据。
STUDENT_ACCOUNTS_ENABLED=false
# 本版广告停用；素材、顺序及配置保留。测试重新开启只使用隔离存储。
ADVERTISEMENTS_ENABLED=false
# 上线时必须设置 https 的同源地址与明确代理网段。
# PUBLIC_ORIGIN=https://print.example.edu
# TRUST_PROXY=loopback
# 各目录必须互不嵌套，不得在 frontend 或参考应用内。
# DB_PATH=var/db/campus-print.sqlite
# STUDENT_FILES_DIR=var/student-files
# PAYMENT_ASSETS_DIR=var/payment-assets
# ADVERTISEMENT_ASSETS_DIR=var/advertisement-assets
# PROCESSING_DIR=var/processing
# FILE_LEDGER_DIR=var/file-ledger
# MANAGED_BACKUPS_DIR=var/managed-backups
